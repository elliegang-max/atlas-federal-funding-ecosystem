# Copy to .env and fill in. Never commit the real .env.
#
# Atlas looks for .env in this folder first, then in the folders above it,
# so a key placed one level above the cloned repo is picked up automatically.

# Course key, used with gpt-6-luna through the Portkey gateway.
PORTKEY_API_KEY=

# Optional. Defaults to https://api.portkey.ai/v1
PORTKEY_BASE_URL=
